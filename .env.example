# Sovereign Agentic AI Workbench - Environment Configuration

# LLM Backend: "ollama" | "demo" | "openai_compatible"
LLM_BACKEND=demo

# Ollama settings (when LLM_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=120

# OpenAI-compatible endpoint (optional)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Embedding model (sentence-transformers, runs locally)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage paths (relative to project root, use pathlib)
DATA_DIR=data
UPLOAD_DIR=data/uploads
VECTORSTORE_DIR=data/vectorstore
CONVERSATION_DIR=data/conversations

# Retrieval
TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Server
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# Logging
LOG_LEVEL=INFO
