# Sovereign Workbench
# This safe preview configuration works without API credentials.
LLM_BACKEND=demo
OFFLINE_MODE=true

# Recommended for stronger answers: configure an API provider that supports
# the OpenAI chat-completions format, then set the following values and restart.
# LLM_BACKEND=openai_compatible
# OFFLINE_MODE=false
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Optional local Ollama backend. In offline mode, keep the URL on localhost/loopback.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=120

# Local document index and audit files
DATA_DIR=data
UPLOAD_DIR=data/uploads
VECTORSTORE_DIR=data/vectorstore
CONVERSATION_DIR=data/conversations

# Retrieval
TOP_K=5
RELEVANCE_THRESHOLD=0.15
CONVERSATION_HISTORY_TOKENS=2000
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Server
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501

# Required for POST /ingest, POST /query, and DELETE /knowledge-base.
# Generate a unique secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Logging and permissions
LOG_LEVEL=INFO
DEFAULT_ROLE=operator
